{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "types": [
      "jest",
      "node"
    ],
    "sourceMap": true
  },
  "include": [
    "src/**/*.ts",
    "generated/**/*.ts"
  ]
}
